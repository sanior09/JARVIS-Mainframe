# ━━━ GROQ API CONFIGURATION ━━━
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_DEFAULT_MODEL=llama-3.3-70b-versatile
GROQ_FAST_MODEL=qwen/qwen3.8-27b
GROQ_STT_MODEL=whisper-large-v3

# ━━━ GEMINI API CONFIGURATION (Deep Thought / Fallback) ━━━
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash

# ━━━ OLLAMA LOCAL CONFIGURATION ━━━
OLLAMA_MODEL=qwen2.5:1.5b
OLLAMA_FAST_MODEL=qwen2.5:1.5b

# ━━━ HOME AUTOMATION (HOME ASSISTANT) ━━━
HOME_ASSISTANT_URL=http://homeassistant.local:8123
HOME_ASSISTANT_TOKEN=your_ha_long_lived_access_token
HA_LIGHT_1=light.living_room
HA_LIGHT_2=light.bedroom

# ━━━ EXTERNAL SERVICES & APIS ━━━
OPENWEATHER_API_KEY=your_openweathermap_api_key
YOUTUBE_API_KEY=your_youtube_data_api_key

# ━━━ NOTIFICATION & EMAIL (GMAIL) ━━━
USER_EMAIL=your_email@gmail.com
SMTP_SERVER=smtp.gmail.com
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=xxxx xxxx xxxx xxxx

# ━━━ LINE MESSAGING API (REMOTE COMMAND WEBHOOK) ━━━
LINE_CHANNEL_ACCESS_TOKEN=your_line_channel_access_token
LINE_CHANNEL_SECRET=your_line_channel_secret
LINE_OWNER_USER_ID=your_line_user_id
NGROK_PUBLIC_URL=https://your-ngrok-domain.ngrok-free.app
LINE_NOTIFY_ON_TASK=false

# ━━━ AUDIO & HARDWARE CONFIGURATION ━━━
MIC_INDEX=1
DEEPGRAM_API_KEY=your_deepgram_api_key

# ━━━ USER & OWNER IDENTITY ━━━
OWNER_NAME=Sir
USER_NAME=Sir

# ━━━ COMPUTER CONTROL PREFERENCE ━━━
# "background" = โหมดทำงานหลังบ้าน ไม่แย่งเมาส์ ไม่บล็อกหน้าจอ
# "visual"     = โหมดเลื่อนเมาส์บนหน้าจอพร้อม Instant Yield
COMPUTER_CONTROL_MODE=background

# ━━━ AUTONOMOUS EVOLUTION & LEARNING ━━━
# รอบเวลาการพัฒนาตัวเองอัตโนมัติ (วินาที): 21600 = ทุก 6 ชั่วโมง
EVOLUTION_INTERVAL_SECONDS=21600
